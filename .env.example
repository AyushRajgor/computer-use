# Copy this file to .env and fill in the keys for the browser you use.
# Other settings: docs/configuration.md and docs/browsers.md

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only for --env browserbase. Key: https://www.browserbase.com/sessions
BROWSERBASE_API_KEY=

# Only for --env browser-use. Key: https://cloud.browser-use.com/settings?tab=api-keys
BROWSER_USE_API_KEY=

# Optional: which browser to use when you don't pass --env
#   playwright   a fresh local Chromium (default)
#   cdp          your everyday Chrome (enable chrome://inspect/#remote-debugging)
#   browserbase  Browserbase cloud browser
#   browser-use  Browser Use cloud browser
# COMPUTER_USE_ENV=playwright
