# Copy this file to .env and fill in the keys for the browser you use.
# All settings: docs/configuration.md and docs/browsers.md

# Required (unless you use Google Cloud, below). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only for --env browserbase. Key: https://www.browserbase.com/sessions
BROWSERBASE_API_KEY=

# Only for --env browser-use. Key: https://cloud.browser-use.com/settings?tab=api-keys
BROWSER_USE_API_KEY=

# Optional: which browser to use when you don't pass --env
#   playwright   a fresh local Chromium (default)
#   cdp          your everyday Chrome (enable chrome://inspect/#remote-debugging)
#   browserbase  Browserbase cloud browser
#   browser-use  Browser Use cloud browser
# COMPUTER_USE_ENV=playwright

# ---------------------------------------------------------------------------
# Using Google Cloud (Vertex AI / Agent Platform) instead of GEMINI_API_KEY?
# Uncomment these, then run: gcloud auth application-default login
# ---------------------------------------------------------------------------
# USE_VERTEXAI=true
# VERTEXAI_PROJECT=your-project-id
# VERTEXAI_LOCATION=global

# ---------------------------------------------------------------------------
# Commonly changed settings: uncomment a line to use it (values are defaults or examples)
# ---------------------------------------------------------------------------
# Model: gemini-3.8-flash, gemini-4-argon, gemini-3.6-flash, gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.8-flash

# true = hide the local browser window
# PLAYWRIGHT_HEADLESS=false

# Stop after this many steps (0 = no limit)
# MAX_STEPS=100

# Risky actions (purchases, sending messages...): ask | deny | auto-confirm
# SAFETY_CONFIRMATION=ask

# Only let the agent visit these sites (comma separated)
# ALLOWED_DOMAINS=google.com,wikipedia.org

# Save every step and screenshot to this folder
# RUN_LOG_DIR=runs
