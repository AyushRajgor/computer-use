# Copy to .env and fill in what you need: `cp .env.example .env`
# Every variable is optional except the Gemini credentials. CLI flags override these.

# ---------------------------------------------------------------------------
# Gemini (pick ONE: Developer API key, or Gemini Enterprise Agent Platform / Vertex AI)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Enterprise Agent Platform (formerly Vertex AI). The Interactions API on
# the platform currently only supports the "global" location.
USE_VERTEXAI=false
VERTEXAI_PROJECT=your_gcp_project_id
VERTEXAI_LOCATION=global

# ---------------------------------------------------------------------------
# Agent defaults
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-3.8-flash          # gemini-4-argon | gemini-3.6-flash | gemini-3.5-flash-lite | gemini-3-flash-preview
# GEMINI_API=interactions                # interactions | generate_content (legacy)
# GEMINI_HISTORY=server                  # server (previous_interaction_id) | client (store=false)
# GEMINI_THINKING_LEVEL=                 # low | medium | high (3.8 Flash default: medium)
# GEMINI_MEDIA_RESOLUTION=               # low | medium | high | ultra_high
# GEMINI_PROMPT_INJECTION_DETECTION=     # true | false (default: on for supported models)
# GEMINI_DISABLED_SAFETY_POLICIES=       # comma separated, e.g. data_modification,account_creation
# GEMINI_EXCLUDED_ACTIONS=               # comma separated predefined actions, e.g. drag_and_drop
# GEMINI_SYSTEM_INSTRUCTION_FILE=        # path to a custom system instruction
# SAFETY_CONFIRMATION=ask                # ask | auto-confirm | deny
# HUMAN_IN_THE_LOOP=false                # offer the yield_to_user function (2FA codes, ...)
# MAX_STEPS=100                          # 0 = unlimited
# RUN_LOG_DIR=runs                       # save trajectory.jsonl + screenshots per run

# ---------------------------------------------------------------------------
# Environment selection
# ---------------------------------------------------------------------------
# COMPUTER_USE_ENV=playwright            # playwright | cdp | browserbase | browser-use | desktop
# INITIAL_URL=https://www.google.com
# SCREEN_SIZE=1440x900

# ---------------------------------------------------------------------------
# Local browser (Playwright) / any CDP browser
# ---------------------------------------------------------------------------
# PLAYWRIGHT_HEADLESS=false              # default: headful if a display is available
# PLAYWRIGHT_CHANNEL=                    # chromium (default) | chrome | msedge
# BROWSER_USER_DATA_DIR=                 # persistent profile directory (keeps logins)
# BROWSER_PROXY_SERVER=                  # e.g. http://proxy:3128
# ALLOWED_DOMAINS=                       # comma separated allowlist (e.g. google.com,wikipedia.org)
# BLOCKED_DOMAINS=                       # comma separated blocklist
# TAB_MODE=single                        # single | follow (switch to new tabs/popups)
# CDP_URL=http://localhost:9222          # for COMPUTER_USE_ENV=cdp

# ---------------------------------------------------------------------------
# Browserbase (https://www.browserbase.com) -- COMPUTER_USE_ENV=browserbase
# ---------------------------------------------------------------------------
BROWSERBASE_API_KEY=your_browserbase_api_key_here
# BROWSERBASE_PROJECT_ID=                # optional, inferred from the API key
# BROWSERBASE_REGION=                    # us-west-2 | us-east-1 | eu-central-1 | ap-southeast-1
# BROWSERBASE_PROXIES=                   # true = managed residential proxies
# BROWSERBASE_PROXY_COUNTRY=             # e.g. US (implies proxies); BROWSERBASE_PROXY_STATE / _CITY optional
# BROWSERBASE_SOLVE_CAPTCHAS=            # default true on Browserbase
# BROWSERBASE_BLOCK_ADS=
# BROWSERBASE_RECORD_SESSION=            # default true on Browserbase
# BROWSERBASE_LOG_SESSION=
# BROWSERBASE_VERIFIED=                  # Verified browser (Scale plan), replaces advanced stealth
# BROWSERBASE_OS=                        # windows | mac | linux | mobile | tablet
# BROWSERBASE_CONTEXT_ID=                # persistent context id (cookies / logins)
# BROWSERBASE_PERSIST_CONTEXT=           # true = save changes back to the context
# BROWSERBASE_EXTENSION_ID=              # uploaded Chrome extension id
# BROWSERBASE_KEEP_ALIVE=
# BROWSERBASE_SESSION_TIMEOUT=           # seconds (60 - 21600)
# BROWSERBASE_IGNORE_CERTIFICATE_ERRORS=
# BROWSERBASE_DOWNLOADS_DIR=             # save the session's downloads (zip) here on exit

# ---------------------------------------------------------------------------
# Browser Use Cloud (https://browser-use.com) -- COMPUTER_USE_ENV=browser-use
# ---------------------------------------------------------------------------
BROWSER_USE_API_KEY=your_browser_use_api_key_here
# BROWSER_USE_PROXY_COUNTRY=             # e.g. us, de, uk ... or "none" to disable (server default: us)
# BROWSER_USE_PROFILE_ID=                # persistent profile (cookies / logins)
# BROWSER_USE_SESSION_TIMEOUT=           # minutes (1 - 240, default 60)
# BROWSER_USE_SOLVE_CAPTCHAS=            # default true
# BROWSER_USE_ENABLE_RECORDING=          # default false
# BROWSER_USE_ALLOW_RESIZING=
# BROWSER_USE_EXTENSION_IDS=             # comma separated (max 3)
# BROWSER_USE_CUSTOM_PROXY=              # [user:pass@]host:port

# ---------------------------------------------------------------------------
# Docker only
# ---------------------------------------------------------------------------
# HEADLESS=false                         # true = no virtual display / live view
# SCREEN_WIDTH=1440
# SCREEN_HEIGHT=900
# VNC_PASSWORD=                          # protect the noVNC live view
# VNC_VIEW_ONLY=false
# KEEP_DISPLAY_OPEN=false                # keep the live view up after the agent finishes
# DESKTOP_STARTUP_APPS=                  # apps opened on the desktop at start, e.g. xterm,chromium
# LIVE_VIEW_PORT=6080                    # host port of the noVNC live view (docker compose)
# DESKTOP_LIVE_VIEW_PORT=6081            # host port for the `desktop` service
